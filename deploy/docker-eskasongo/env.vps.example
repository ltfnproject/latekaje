# Template .env Produksi LATEKAJE v4 untuk VPS eskasongo
# Salin ke ./src/.env lalu isi semua nilai placeholder (JANGAN pernah commit .env asli ke Git!)

APP_NAME="LATEKAJE TJKT"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://inv.tjkt.smkw9jepara.sch.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Shared MySQL container pada app-network
DB_CONNECTION=mysql
DB_HOST=core-db-mysql
DB_PORT=3306
DB_DATABASE=smk_latekaje
DB_USERNAME=smk_latekaje
DB_PASSWORD=GANTI_PASSWORD_DB_YANG_KUAT
DB_PREFIX=

# Akun Super Admin awal (dipakai saat `php artisan migrate --seed`)
SUPERADMIN_NAME="Tim IT Lab TJKT"
SUPERADMIN_EMAIL="admin@tjkt.smkw9jepara.sch.id"
SUPERADMIN_PASSWORD="GANTI_PASSWORD_SUPERADMIN_KUAT"

# WAJIB false di produksi agar tidak membuat data demo
SEED_DEMO=false

# Keamanan Fase 1 (LATEKAJE v4)
# Subnet Docker bridge / core-proxy-npm agar deteksi HTTPS & IP klien akurat
TRUSTED_PROXIES=172.16.0.0/12
# Fail-closed: akun peminjam tanpa NIS/member_id tidak boleh melihat semua pinjaman
ALLOW_GENERIC_KIOSK=false
# Host internal tepercaya untuk GOWA/Webhook (pisahkan koma, misal: core-gowa,100.64.0.10)
SAFE_URL_ALLOWED_HOSTS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@tjkt.smkw9jepara.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
